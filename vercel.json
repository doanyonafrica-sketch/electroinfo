{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/sitemap.xml",          "destination": "/api/sitemap" },
    { "source": "/article/:slug",        "destination": "/article-detail" },
    { "source": "/matiere/:slug",        "destination": "/matiere" },
    { "source": "/seance/:slug/:seq/:s", "destination": "/seance" },
    { "source": "/seance/:slug/:seq",    "destination": "/seance" },
    { "source": "/seance/:slug",         "destination": "/seance" }
  ]
}
